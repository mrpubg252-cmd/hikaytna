.ys-section-title::before{content:"";position:absolute;inset-inline-start:0;top:.35em;width:5px;height:1.05em;border-radius:99px;background:linear-gradient(var(--ys-accent),var(--ys-accent-2));box-shadow:0 0 0 4px color-mix(in srgb,var(--ys-accent) 8%,transparent)}
.ys-section-desc{margin:4px 0 0;color:var(--ys-muted);font-size:11px}
.ys-more{display:inline-flex;align-items:center;gap:5px;padding:7px 10px;border-radius:10px;background:color-mix(in srgb,var(--ys-accent) 8%,#fff);color:var(--ys-accent-2);font-size:11px;font-weight:800}
.ys-match-page-nav{display:flex;gap:6px;flex-wrap:wrap;margin:0 0 14px;padding:5px;background:#fff;border:1px solid var(--ys-border);border-radius:14px;box-shadow:var(--ys-shadow-sm)}
.ys-match-page-nav a{display:inline-flex;justify-content:center;min-width:105px;padding:9px 13px;border-radius:10px;font-size:11px;font-weight:800;color:var(--ys-muted)}
.ys-match-page-nav a.current{background:var(--ys-accent);color:#fff;box-shadow:0 6px 16px color-mix(in srgb,var(--ys-accent) 24%,transparent)}
.ys-section-head--matches{align-items:center}
.ys-section-head--matches .ys-match-page-nav{margin:0;flex-wrap:nowrap;background:var(--ys-soft);box-shadow:none}
.ys-section-head--matches .ys-match-page-nav a{min-width:82px;padding:8px 11px}

/* Match table */
.ys-plugin-shell .ysmatch-wrap,.ys-plugin-shell .ysmatch-competitions{margin:0}
.ysmatch-wrap,.ysmatch-competitions,.ysmatch-standalone,.ysmatch-match-page{--ys:var(--ys-accent)!important;--txt:var(--ys-text)!important;--muted:var(--ys-muted)!important;--bd:var(--ys-border)!important;--soft:var(--ys-soft)!important;font-family:inherit!important}
.ysmatch-wrap *{box-sizing:border-box}
.ysmatch-league-group{position:relative;margin-bottom:13px;background:#fff;border:1px solid var(--ys-border);border-radius:20px;overflow:hidden;box-shadow:var(--ys-shadow-sm);contain:layout paint}
.ysmatch-league-group::before{content:"";position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg,transparent,var(--ys-accent),transparent);opacity:.72}
.ysmatch-league-head{display:flex;align-items:center;gap:9px;padding:11px 13px;background:linear-gradient(180deg,#fff,var(--ys-soft));border-bottom:1px solid var(--ys-border)}
.ysmatch-league-head img,.ysmatch-league-head .ys-img-placeholder{width:30px;height:30px;flex:0 0 30px}
.ysmatch-league-head strong{font-size:12px;font-weight:850}
.ysmatch-league-head span{margin-inline-start:auto;padding:4px 7px;border-radius:99px;background:#fff;border:1px solid var(--ys-border);color:var(--ys-muted);font-size:9px;font-weight:700}
.ysmatch-games-list{background:#fff}
.ysmatch-match-card{position:relative;display:grid;grid-template-columns:minmax(0,1fr) 104px minmax(0,1fr);align-items:center;gap:10px;min-height:88px;padding:10px 14px;color:inherit!important;background:#fff;border-bottom:1px solid #edf0f4;text-decoration:none!important;transition:background .16s ease,transform .16s ease}
.ysmatch-match-card:last-child{border-bottom:0}
.ysmatch-match-card:hover{z-index:2;background:linear-gradient(90deg,#fff,color-mix(in srgb,var(--ys-accent) 4%,#fff),#fff)}
.ysmatch-match-card:active{transform:scale(.995)}
.ysmatch-match-card[data-match-status="live"]{background:linear-gradient(90deg,#fff,color-mix(in srgb,#ef4444 5%,#fff),#fff)}
.ysmatch-match-card[data-match-status="live"]::after{content:"";position:absolute;inset-inline-start:0;top:50%;width:3px;height:38px;transform:translateY(-50%);border-radius:0 99px 99px 0;background:#ef4444}
.ysmatch-team{display:flex;align-items:center;justify-content:center;gap:9px;min-width:0;text-align:center}
.ysmatch-team img,.ysmatch-team .ys-img-placeholder{width:46px;height:46px;flex:0 0 46px;padding:4px;background:#fff;border:1px solid #edf0f3;border-radius:50%;object-fit:contain;box-shadow:0 4px 12px rgba(15,23,42,.05)}
.ys-img-placeholder{display:inline-block;background:#eef2f6;border-radius:50%}
.ysmatch-team span{min-width:0;font-size:12px;font-weight:850;line-height:1.4}
.ysmatch-match-center{display:flex;flex-direction:column;align-items:center;gap:4px;text-align:center}
.ysmatch-match-center b{display:grid;place-items:center;min-width:70px;min-height:32px;padding:5px 9px;border:1px solid var(--ys-border);border-radius:10px;background:#0f172a;color:#fff;font-size:13px;line-height:1;font-weight:850;box-shadow:0 6px 14px rgba(15,23,42,.11)}
.ysmatch-match-center small{display:inline-flex;align-items:center;justify-content:center;min-height:20px;padding:2px 7px;border-radius:99px;background:#f2f4f7;color:var(--ys-muted);font-size:9px;font-weight:800;line-height:1.2}
.ysmatch-match-center small.ysmatch-live{background:#fff1f2;color:#e11d48}
.ysmatch-match-center small.ysmatch-live::before{content:"";width:6px;height:6px;margin-inline-end:4px;border-radius:50%;background:#e11d48;box-shadow:0 0 0 3px rgba(225,29,72,.10);animation:ysPulse 1.4s infinite}
.ysmatch-match-center em{font-size:9px;color:var(--ys-muted);font-style:normal}
@keyframes ysPulse{50%{opacity:.35;transform:scale(.75)}}
.ysmatch-message{padding:24px;border:1px dashed #d7dde5;background:#fff;border-radius:17px;text-align:center;color:var(--ys-muted);font-size:12px}

/* Leagues */
.ys-fast-leagues{background:#fff;border:1px solid var(--ys-border);border-radius:20px;padding:16px;box-shadow:var(--ys-shadow-sm)}
.ys-league-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}
.ys-league-card{display:flex;align-items:center;gap:10px;min-width:0;padding:11px;border:1px solid var(--ys-border);border-radius:14px;background:linear-gradient(180deg,#fff,#fbfcfd);transition:border-color .16s ease,transform .16s ease,box-shadow .16s ease}
.ys-league-card:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--ys-accent) 45%,var(--ys-border));box-shadow:0 8px 20px rgba(15,23,42,.06)}
.ys-league-card img,.ys-league-fallback{width:36px;height:36px;flex:0 0 36px}
.ys-league-card img{object-fit:contain}
.ys-league-fallback{display:grid;place-items:center;background:color-mix(in srgb,var(--ys-accent) 8%,#fff);border:1px solid color-mix(in srgb,var(--ys-accent) 15%,#fff);border-radius:11px;font-size:17px}
.ys-league-card>span:last-child{min-width:0}
.ys-league-card strong,.ys-league-card small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ys-league-card strong{font-size:11px}
.ys-league-card small{margin-top:2px;color:var(--ys-muted);font-size:8px}

/* Widgets */
.ys-widget-zone{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;margin:15px 0 22px}
.ys-widget-zone:empty{display:none}
.ys-widget{background:#fff;border:1px solid var(--ys-border);border-radius:18px;padding:15px;box-shadow:var(--ys-shadow-sm)}
.ys-widget-title{margin:0 0 10px;font-size:14px;font-weight:850}
.ys-widget ul{margin:0;padding:0;list-style:none}
.ys-widget li+li{border-top:1px solid var(--ys-border)}
.ys-widget li a{display:block;padding:8px 0;font-size:11px}
.ys-widget img{border-radius:10px}
.ys-widget select,.ys-widget input[type="search"],.ys-widget input[type="text"]{width:100%;min-height:40px;border:1px solid var(--ys-border);border-radius:10px;background:#fff;padding:7px 10px}
.ys-widget button,.ys-widget input[type="submit"]{border:0;border-radius:10px;background:var(--ys-accent);color:#fff;padding:8px 13px;font-weight:800;cursor:pointer}

/* Posts */
.ys-post-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.ys-post-card{position:relative;overflow:hidden;background:#fff;border:1px solid var(--ys-border);border-radius:20px;box-shadow:var(--ys-shadow-sm);content-visibility:auto;contain-intrinsic-size:280px;transition:transform .18s ease,box-shadow .18s ease}
.ys-post-card:hover{transform:translateY(-3px);box-shadow:0 16px 32px rgba(15,23,42,.085)}
.ys-post-thumb{display:block;aspect-ratio:16/9;background:#edf1f5;overflow:hidden}
.ys-post-thumb img{width:100%;height:100%;object-fit:cover;transition:transform .35s ease}
.ys-post-card:hover .ys-post-thumb img{transform:scale(1.035)}
.ys-post-body{padding:14px}
.ys-post-meta{display:flex;align-items:center;gap:6px;color:var(--ys-muted);font-size:9px}
.ys-post-title{margin:7px 0 6px;font-size:14px;line-height:1.7;font-weight:850}
.ys-post-excerpt{margin:0;color:var(--ys-muted);font-size:11px;line-height:1.8}
.ys-pagination{margin-top:20px}
.ys-pagination .nav-links{display:flex;justify-content:center;gap:6px;flex-wrap:wrap}
.ys-pagination a,.ys-pagination span{min-width:36px;height:36px;display:grid;place-items:center;border:1px solid var(--ys-border);border-radius:10px;background:#fff;font-size:11px}
.ys-pagination .current{background:var(--ys-accent);border-color:var(--ys-accent);color:#fff}

/* Article */
.ys-content-layout{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:20px}
.ys-content-layout.ys-full{grid-template-columns:1fr}
.ys-article{min-width:0;background:#fff;border:1px solid var(--ys-border);border-radius:24px;padding:24px;box-shadow:var(--ys-shadow-sm)}
.ys-article-header{margin-bottom:16px}
.ys-article-title{margin:0;font-size:clamp(23px,3vw,35px);line-height:1.55;letter-spacing:-.5px;font-weight:850}
.ys-article-meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:9px;color:var(--ys-muted);font-size:10px}
.ys-entry{font-size:14px}
.ys-entry h2{margin:27px 0 10px;font-size:20px;line-height:1.6}
.ys-entry h3{margin:21px 0 9px;font-size:17px}
.ys-entry p{margin:0 0 15px}
.ys-entry ul,.ys-entry ol{padding-inline-start:22px}
.ys-entry a:not(.ysmatch-watch-btn){color:var(--ys-accent-2);text-decoration:underline;text-underline-offset:3px}
.ys-entry blockquote{margin:18px 0;padding:14px 16px;border-inline-start:4px solid var(--ys-accent);background:var(--ys-soft);border-radius:12px}
.ys-entry table{max-width:100%}
.ys-entry .ysmatch-article-top{margin-bottom:22px}
.ys-entry .ysmatch-article-content{border-top:1px solid var(--ys-border);padding-top:20px}
.ys-sidebar{display:flex;flex-direction:column;gap:14px}
.ys-sidebar .ys-widget{margin:0}
.ys-breadcrumbs{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin:0 0 11px;color:var(--ys-muted);font-size:10px}
.ys-breadcrumbs a:hover{color:var(--ys-accent-2)}
.ys-article-featured{margin-bottom:18px;border-radius:16px}

/* Taxonomies */
.ys-tax-head{position:relative;display:flex;align-items:center;gap:14px;padding:18px;margin-bottom:17px;background:#fff;border:1px solid var(--ys-border);border-radius:22px;box-shadow:var(--ys-shadow-sm);overflow:hidden}
.ys-tax-head::after{content:"";position:absolute;inset-inline-end:-45px;top:-55px;width:130px;height:130px;border-radius:50%;background:color-mix(in srgb,var(--ys-accent) 10%,transparent)}
.ys-tax-head img{position:relative;z-index:1;width:58px;height:58px;padding:5px;background:#fff;border:1px solid var(--ys-border);border-radius:16px;object-fit:contain}
.ys-tax-head h1{position:relative;z-index:1;margin:0;font-size:21px}
.ys-tax-head p{position:relative;z-index:1;margin:2px 0 0;color:var(--ys-muted);font-size:11px}
.ys-tax-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:15px;margin-top:18px}

/* Footer */
.ys-site-footer{position:relative;margin-top:34px;background:#0b1220;color:#dbe4ef;overflow:hidden}
.ys-site-footer::before{content:"";position:absolute;top:-140px;inset-inline-start:10%;width:340px;height:340px;border-radius:50%;background:color-mix(in srgb,var(--ys-accent) 14%,transparent);filter:blur(1px)}
.ys-footer-top{position:relative;display:grid;grid-template-columns:minmax(220px,1.1fr) repeat(auto-fit,minmax(150px,1fr));gap:24px;padding:38px 0 29px}
.ys-footer-brand .ys-brand{color:#fff}
.ys-footer-brand .ys-brand-mark{box-shadow:none}
.ys-footer-brand p{margin:13px 0 0;max-width:330px;color:#93a2b6;font-size:11px}
.ys-footer-widget{font-size:11px}
.ys-footer-widget .ys-widget{background:transparent;border:0;border-radius:0;padding:0;box-shadow:none;color:inherit}
.ys-footer-widget .ys-widget-title{color:#fff}
.ys-footer-widget ul{margin:0;padding:0;list-style:none}
.ys-footer-widget li+li{margin-top:6px}
.ys-footer-widget a{color:#aeb9c8}
.ys-footer-widget a:hover{color:#fff}
.ys-footer-bottom{position:relative;border-top:1px solid rgba(255,255,255,.08);padding:14px 0}
.ys-footer-bottom-row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.ys-copyright{margin:0;color:#8e9cac;font-size:10px}
.ys-footer-menu a{display:block;padding:4px 7px;color:#aeb8c5;font-size:10px}

/* 404 */
.ys-empty{padding:48px 20px;text-align:center;background:#fff;border:1px solid var(--ys-border);border-radius:24px;box-shadow:var(--ys-shadow-sm)}
.ys-empty strong{display:block;font-size:66px;line-height:1;color:var(--ys-accent)}
.ys-empty h1{margin:10px 0 6px;font-size:22px}
.ys-empty p{margin:0 0 15px;color:var(--ys-muted)}
.ys-btn{display:inline-flex;padding:9px 14px;border-radius:10px;background:var(--ys-accent);color:#fff!important;font-weight:800;font-size:11px}

/* App promo - lightweight banner injected by JS only for visitors */
.ys-app-promo{position:relative;z-index:900;width:100%;direction:rtl;padding:10px 0;opacity:0;transform:translateY(-6px);transition:opacity .18s ease,transform .18s ease}.ys-app-promo.is-visible{opacity:1;transform:none}.ys-app-promo__inner{position:relative;width:min(1180px,calc(100% - 30px));margin-inline:auto;display:flex;align-items:flex-start;flex-wrap:wrap;gap:10px 12px;padding:14px 14px 14px 12px;border:1px solid color-mix(in srgb,var(--ys-accent) 24%,var(--ys-border));border-radius:22px;background:linear-gradient(125deg,color-mix(in srgb,var(--ys-accent) 11%,#fff),#fff 44%,color-mix(in srgb,var(--ys-accent) 5%,#fff));box-shadow:0 12px 28px rgba(15,23,42,.08);overflow:hidden}.ys-app-promo__inner::after{content:"";position:absolute;width:180px;height:180px;inset-inline-start:-60px;top:-95px;border-radius:50%;background:color-mix(in srgb,var(--ys-accent) 12%,transparent);pointer-events:none}.ys-app-promo__logo{position:relative;z-index:1;display:grid;place-items:center;width:54px;height:54px;flex:0 0 54px;border-radius:18px;background:linear-gradient(145deg,var(--ys-accent),var(--ys-accent-2));box-shadow:0 10px 24px color-mix(in srgb,var(--ys-accent) 24%,transparent);font-size:28px;line-height:1}.ys-app-promo__copy{position:relative;z-index:1;min-width:0;display:flex;flex:1 1 0;flex-direction:column;gap:3px;padding-inline-end:40px}.ys-app-promo__title{font-size:15px;line-height:1.5;font-weight:900;color:var(--ys-text)}.ys-app-promo__text{max-width:none;color:var(--ys-muted);font-size:12px;line-height:1.8;white-space:normal;overflow:visible;text-overflow:clip;overflow-wrap:anywhere}.ys-app-promo__actions{position:relative;z-index:1;display:flex;align-items:stretch;gap:10px;flex:0 0 100%;width:100%;margin-top:4px}.ys-app-promo__btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:54px;width:100%;padding:12px 18px;border-radius:16px;font-size:15px;font-weight:900;letter-spacing:0;transition:transform .15s ease,filter .15s ease,box-shadow .15s ease;box-shadow:0 12px 30px rgba(15,23,42,.10)}.ys-app-promo__btn:hover{filter:brightness(1.03);transform:translateY(-1px)}.ys-app-promo__btn--android{background:linear-gradient(145deg,var(--ys-accent),var(--ys-accent-2));color:#fff;box-shadow:0 14px 28px color-mix(in srgb,var(--ys-accent) 24%,transparent)}.ys-app-promo__btn--ios{background:linear-gradient(145deg,#111827,#1f2937);color:#fff}.ys-app-promo__store-icon{display:grid;place-items:center;min-width:26px;height:26px;padding-inline:6px;border-radius:8px;background:rgba(255,255,255,.14);font-size:11px;line-height:1;font-weight:900}.ys-app-promo__close{position:absolute;z-index:2;top:12px;inset-inline-start:12px;display:grid;place-items:center;width:31px;height:31px;padding:0;border:1px solid var(--ys-border);border-radius:10px;background:#fff;color:#667085;font-size:18px;line-height:1;cursor:pointer;box-shadow:0 6px 16px rgba(15,23,42,.08)}.ys-app-promo--sticky-bottom,.ys-app-promo--sticky-top{position:fixed;z-index:99990;left:0;right:0;padding:8px 0;pointer-events:none}.ys-app-promo--sticky-bottom{bottom:0;padding-bottom:calc(8px + env(safe-area-inset-bottom))}.ys-app-promo--sticky-top{top:0}.ys-app-promo--sticky-bottom .ys-app-promo__inner,.ys-app-promo--sticky-top .ys-app-promo__inner{pointer-events:auto;box-shadow:0 14px 42px rgba(15,23,42,.16)}@media (min-width:861px){.ys-app-promo__actions .ys-app-promo__btn{flex:1 1 0}}@media (max-width:860px){.ys-app-promo__inner{width:min(100% - 18px,1180px);padding:12px 12px 12px 10px;gap:9px 10px}.ys-app-promo__logo{width:48px;height:48px;flex-basis:48px;border-radius:16px;font-size:25px}.ys-app-promo__copy{flex-basis:calc(100% - 58px);padding-inline-end:36px}.ys-app-promo__title{font-size:14px}.ys-app-promo__text{font-size:11px;line-height:1.75}.ys-app-promo__actions{gap:8px}.ys-app-promo__btn{min-height:50px;font-size:14px;padding:11px 14px;border-radius:15px}.ys-app-promo__close{top:10px;inset-inline-start:10px;width:29px;height:29px}}

/* Render/performance helpers */
.ys-defer-render{content-visibility:auto;contain-intrinsic-size:1px 500px}
.ys-team-logo,.ys-league-logo,.ys-league-card-logo{object-fit:contain}

/* Skin 1: Pulse - default */
body.ys-skin-pulse .ys-header-row{border-radius:22px}
body.ys-skin-pulse .ysmatch-match-center b{background:linear-gradient(145deg,#111827,#1f2937)}

/* Skin 2: Edge - angular and compact */
body.ys-skin-edge{--ys-bg:#f5f6f8;--ys-radius:12px;--ys-radius-sm:8px;--ys-shadow:0 10px 22px rgba(15,23,42,.055)}
body.ys-skin-edge .ys-site-header{padding-top:0;background:#fff;border-bottom:1px solid var(--ys-border)}
body.ys-skin-edge .ys-header-row{min-height:66px;padding-inline:0;border:0;border-radius:0;box-shadow:none;background:#fff}
body.ys-skin-edge .ys-brand-mark{border-radius:7px;transform:skew(-7deg)}
body.ys-skin-edge .ys-brand-mark::before{transform:skew(7deg)}
body.ys-skin-edge .ys-match-links,body.ys-skin-edge .ys-match-page-nav{border-radius:7px}
body.ys-skin-edge .ys-match-links a,body.ys-skin-edge .ys-match-page-nav a{border-radius:5px}
body.ys-skin-edge .ys-section-title{padding-inline-start:0;padding-bottom:6px}
body.ys-skin-edge .ys-section-title::before{top:auto;bottom:0;width:44px;height:3px;border-radius:0;box-shadow:none}
body.ys-skin-edge .ysmatch-league-group,body.ys-skin-edge .ys-fast-leagues,body.ys-skin-edge .ys-post-card,body.ys-skin-edge .ys-widget,body.ys-skin-edge .ys-article{border-radius:10px;box-shadow:none}
body.ys-skin-edge .ysmatch-league-group::before{display:none}
body.ys-skin-edge .ysmatch-league-head{background:#101828;color:#fff;border-bottom:0}
body.ys-skin-edge .ysmatch-league-head span{background:#1d2939;border-color:#344054;color:#d0d5dd}
body.ys-skin-edge .ysmatch-match-card{min-height:80px}
body.ys-skin-edge .ysmatch-team img{border-radius:9px}
body.ys-skin-edge .ysmatch-match-center b{border-radius:5px;background:var(--ys-accent)}
body.ys-skin-edge .ys-league-card{border-radius:8px}
body.ys-skin-edge .ys-post-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:11px}
body.ys-skin-edge .ys-post-card{border-top:3px solid var(--ys-accent)}
body.ys-skin-edge .ys-post-thumb{aspect-ratio:4/3}

/* Skin 3: Halo - spacious and soft */
body.ys-skin-halo{--ys-bg:#f7f9fc;--ys-radius:30px;--ys-shadow-sm:0 18px 45px rgba(15,23,42,.07)}
body.ys-skin-halo .ys-header-row{min-height:78px;border-radius:30px;padding-inline:18px}
body.ys-skin-halo .ys-brand-mark{width:42px;height:42px;flex-basis:42px;border-radius:50%}
body.ys-skin-halo .ysmatch-league-group,body.ys-skin-halo .ys-fast-leagues,body.ys-skin-halo .ys-post-card,body.ys-skin-halo .ys-widget,body.ys-skin-halo .ys-article{border-radius:28px}
body.ys-skin-halo .ysmatch-league-head{padding:14px 16px}
body.ys-skin-halo .ysmatch-match-card{min-height:98px;padding-block:14px}
body.ys-skin-halo .ysmatch-team img{width:52px;height:52px;flex-basis:52px}
body.ys-skin-halo .ysmatch-match-center b{border-radius:99px;padding-inline:15px;background:#fff;color:#111827}
body.ys-skin-halo .ys-post-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
body.ys-skin-halo .ys-post-thumb{aspect-ratio:21/10}
body.ys-skin-halo .ys-post-body{padding:17px 18px}
body.ys-skin-halo .ys-post-title{font-size:16px}

/* Skin 4: Nightline - dark top identity */
body.ys-skin-nightline{--ys-bg:#f2f4f7}
